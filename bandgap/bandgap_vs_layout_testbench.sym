N -250 40 -250 60 {lab=VDD}
N -250 120 -250 140 {lab=0}
N 140 30 170 30 {lab=out}
N 140 90 180 90 {lab=out_layout}
C {bandgap.sym} -10 30 0 0 {name=x1}
C {vdd.sym} -250 40 0 0 {name=l1 lab=VDD}
C {gnd.sym} -250 140 0 0 {name=l2 lab=0}
C {vsource.sym} -250 90 0 0 {name=V1 value=vdd savecurrent=false}
C {opin.sym} 170 30 0 0 {name=p1 lab=out}
C {simulator_commands_shown.sym} 560 60 0 0 {name=COMMANDS
simulator=ngspice
only_toplevel=false 
value="


	#dc temp -20 100 1
	#dc V1 0 3.3 0.01
	#tran 0.01m 1m
.global VDD 0 sub!
.param Rval = 56k
.param vdd = 3.3
.param W = 2u
.param K = 1
.param L = 5u
.options rshunt=1e12
.control

save all
shell rm -f bandgap_vs_layout_testbench.raw
set appendwrite
#600k 672k 700k 800k 1000K
foreach val 389K 
	alterparam Rval = $val
	reset
	#dc temp -20 120 1
	dc V1 0 3.3 0.001
	write bandgap_vs_layout_testbench.raw
end
unset appendwrite
#write bandgap_vs_layout_testbench.raw

.endc
"}
C {devices/code_shown.sym} -230 340 0 0 {name=MODEL only_toplevel=true
format="tcleval( @value )"
value="
.lib ~src/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models/cornerHBT.lib hbt_typ
.lib ~src/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models/cornerMOSlv.lib mos_tt
.lib ~src/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models/cornerMOShv.lib mos_tt
.lib ~src/IHP-Open-PDK/ihp-sg13g2/libs.tech/ngspice/models/cornerRES.lib res_typ

"
}
C {code_shown.sym} 100 200 0 0 {name=s1 only_toplevel=false value=".include ../bandgap_layout.spice"}
C {bandgap_layout.sym} -10 90 0 0 {name=x2}
C {opin.sym} 180 90 0 0 {name=p2 lab=out_layout}
